# regulations.gov — optional. Falls back to "DEMO_KEY" if unset
# (rate-limited but functional). Get a free key at https://api.data.gov/signup/
REGULATIONS_GOV_API_KEY=DEMO_KEY

# Clerk (auth) — optional. If unset, the app falls back to localStorage-only
# mode for profiles. Real Save/Commented/Activity require these.
# Get keys at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk webhook signing secret — from Clerk Dashboard → Webhooks → your endpoint
# Subscribe to: user.created, user.deleted
CLERK_WEBHOOK_SECRET=

# Supabase (database) — optional. If unset, the app falls back to
# localStorage-only mode. Real Save/Commented/Activity require these.
# Create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM text-generation provider: gemini | groq | mistral (default: gemini)
# Only the matching API key is required for the chosen provider.
LLM_PROVIDER=gemini

# Gemini — default provider. Also required for semantic embeddings regardless
# of LLM_PROVIDER (text-embedding-004 has no equivalent free alternative).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — free fallback (no credit card). Llama 3.1 8B / 3.3 70B.
# 14,400 req/day on the free tier. Set LLM_PROVIDER=groq to activate.
# Get a key at https://console.groq.com
GROQ_API_KEY=

# Mistral — free fallback (no credit card). Mistral Small / Medium.
# 1B tokens/month on the free tier. Set LLM_PROVIDER=mistral to activate.
# Get a key at https://console.mistral.ai
MISTRAL_API_KEY=

# Upstash Redis — optional but strongly recommended for production.
# Without it, the regulations list is re-fetched from regulations.gov on every
# cold start. Free tier at upstash.com covers the load.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (email) — optional. Required for Phase 2 features: weekly digest,
# closing-soon alerts, final-rule notifications. Without it, send routes
# log a warning and no-op so the cron jobs stay green.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# The verified sender address (must match a domain you've verified in Resend).
# Defaults to "OpenComment <hello@opencomment.org>" if unset.
RESEND_FROM_EMAIL=

# Public app URL — used to build links in outbound email (e.g. unsubscribe).
# Set to your Vercel deployment URL in production. Defaults to localhost in dev.
NEXT_PUBLIC_APP_URL=

# Cron secret — random string used to authenticate manual cron triggers.
# Vercel Cron requests are auto-authorized via the x-vercel-cron header.
CRON_SECRET=
